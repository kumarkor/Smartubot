{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/userid-:id",
      "destination": "/index.html?userid=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
